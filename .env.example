# Theses settings work for dev but please change them for deployment
AUTH_SECRET=my-super-secret
AUTH_URL=http://localhost:3000
# OIDC Settings
# Currently only one provider is supported at one time
OIDC_NAME="OIDC Mock"
OIDC_ISSUER=https://oidcmock.dev
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=test-client-secret
# Whit Whitelisted emails you can add a comma seperated list of emails 
# Users not on that list will not be able to login
# This is helpful if you want to run a private instance for you and your firends
# WHITELISTED_EMAILS=john@example.com,jane@company.com
#DB
DATABASE_HOST=127.0.0.1
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_MIGRATE=true
#S3
S3_REGION=auto
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minio-dev
S3_SECRET_ACCESS_KEY=minio-dev
S3_BUCKET_NAME=test

# Processing
PROCESSING_KEY=key # This kee needs to be the same in the processing service
PROCESSING_URL=http://localhost:8000

# SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=mememememe@your.mom
